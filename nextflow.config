/*
 * psychENCODE Reanalysis Pipeline Configuration
 *
 * Usage:
 *   nextflow run main.nf -params-file params.class.json
 *   nextflow run main.nf -params-file params.subclass.json
 */

// Pipeline manifest
manifest {
    name            = 'psychENCODE-reanalysis'
    description     = 'Differential expression analysis of single-cell RNA-seq data'
    version         = '2.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

// Load base configuration
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Enable conda
conda.enabled = true

//=======================1======================================================
// Default Parameters (override with -params-file params.class.json)
//=============================================================================

params {
    // Stage control
    run_de_analysis = true
    run_comparison = true
    skip_de_analysis = false
    skip_comparison = false

    // Data source
    from_gemma = true
    author_submitted = false

    // Input paths
    study_names = "${projectDir}/shortnames.txt"
    h5ad_files = "/space/grp/rschwartz/rschwartz/get_gemma_data.nf/psychencode.txt_author_false_process_samples_false/h5ad"
    gemma_meta_dir = "${projectDir}/gemma/metadata"

    // Output
    outdir = "${projectDir}/results"

    // Analysis options - these get overridden by params.class.json or params.subclass.json
    level = "class"
    cta_version = "2.0.0"
    cell_type_column = "cell_type"
    filter_genes = false
    filter_samples = false

    // Author data paths
    author_results = "/space/grp/rschwartz/rschwartz/psychENCODE-reanalysis/source_data/DEGs/*csv"
    author_pseudobulks = "${projectDir}/source_data/pseudobulks/pseudobulk_expr/*bed.gz"

    // F1 score benchmarking file for heatmap annotations
    f1_path = null

    // Pre-existing results paths - set in params JSON files
    pavlab_deseq_results = null
    author_label_deseq_results = "/space/grp/rschwartz/rschwartz/psychENCODE-reanalysis/gemma-de-author/DESeq2/gemma/**tsv"

    // Cell type annotation files - set in params JSON files
    celltype_annotation_files = [:]

    // Cell type mappings - set in params JSON files
    gemma_ct_map = [:]
    author_ct_map = [:]
    gemma_to_gemma_map = [:]
}

//=============================================================================
// Profiles
//=============================================================================

profiles {
    conda {
        conda.enabled = true
    }
}
