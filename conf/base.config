/*
 * Base configuration for all processes
 */

process {
    cache = 'standard'
    executor = 'local'

    // Default resources
    cpus = 1
    memory = '4.GB'
    time = '1.h'

    // Process labels for resource management
    withLabel: 'process_low' {
        cpus = 1
        memory = '2.GB'
        time = '30.m'
    }

    withLabel: 'process_medium' {
        cpus = 4
        memory = '8.GB'
        time = '2.h'
    }

    withLabel: 'process_high' {
        cpus = 8
        memory = '16.GB'
        time = '4.h'
    }
}

executor {
    queueSize = 90
}
