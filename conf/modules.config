/*
 * Module-specific configuration
 * Defines conda environments and process-specific settings
 */

process {
    // Python-based processes (scanpy environment)
    withName: 'AGGREGATE_CELLTYPES_GEMMA|AGGREGATE_DATA_MANUAL|AGGREGATE_CELLTYPES_MANUAL|AGGREGATE_PAIRWISE|DE_OVERLAP|AVERAGE_DE_OVERLAPS|AVERAGE_DE_CORRELATIONS' {
        conda = "/home/rschwartz/anaconda3/envs/scanpyenv"
    }

    // R-based processes (DESeq2)
    withName: 'DESEQ2_ANALYSIS_GEMMA|DESEQ2_ANALYSIS_MANUAL' {
        conda = "/home/rschwartz/anaconda3/envs/r4.3"
    }
}
